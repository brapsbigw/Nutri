// nutritionist-management/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────
// USER & AUTH
// ─────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  role          String    @default("CLIENT") // ADMIN | NUTRITIONIST | CLIENT
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  // Relations
  nutritionistProfile  NutritionistProfile?
  clientProfile        ClientProfile?
  sentMessages         Message[]             @relation("MessageSender")
  notifications        Notification[]
  notificationPrefs    NotificationPreference[]
  auditLogs            AuditLog[]
  goalProgressRecords  GoalProgress[]        @relation("GoalProgressRecorder")
  measurementsRecorded Measurement[]         @relation("MeasurementRecorder")

  @@index([email])
  @@index([role])
  @@map("users")
}

// ─────────────────────────────────────────
// CLINIC & NUTRITIONIST
// ─────────────────────────────────────────

model Clinic {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  email     String?
  logoUrl   String?
  ownerId   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members              ClinicMember[]
  nutritionistProfiles NutritionistProfile[]

  @@map("clinics")
}

model ClinicMember {
  id       String   @id @default(cuid())
  clinicId String
  userId   String
  role     String   @default("MEMBER") // OWNER | ADMIN | MEMBER
  joinedAt DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, userId])
  @@map("clinic_members")
}

model NutritionistProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  clinicId           String?
  name               String
  bio                String?
  phone              String?
  licenseNumber      String?
  specializations    String?  // comma-separated
  avatarUrl          String?
  stripeCustomerId   String?  @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinic        Clinic?         @relation(fields: [clinicId], references: [id])
  subscription  Subscription?
  clients       ClientProfile[]
  invites       Invite[]
  customFoods   Food[]          @relation("NutritionistFoods")
  plans         NutritionPlan[]
  consultations Consultation[]
  notes         Note[]
  goals         Goal[]
  conversations Conversation[]

  @@index([userId])
  @@map("nutritionist_profiles")
}

// ─────────────────────────────────────────
// CLIENT
// ─────────────────────────────────────────

model ClientProfile {
  id             String    @id @default(cuid())
  userId         String?   @unique // null before client registers and redeems invite
  nutritionistId String
  name           String
  email          String?
  dateOfBirth    DateTime?
  phone          String?
  gender         String?
  notes          String?
  status         String    @default("ACTIVE") // ACTIVE | INACTIVE | ARCHIVED
  joinedAt       DateTime  @default(now())
  lastActivityAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  user           User?               @relation(fields: [userId], references: [id])
  nutritionist   NutritionistProfile @relation(fields: [nutritionistId], references: [id])
  invite         Invite?
  plans          NutritionPlan[]
  goals          Goal[]
  consultations  Consultation[]
  measurements   Measurement[]
  mealLogs       MealLog[]
  progressPhotos ProgressPhoto[]
  conversations  Conversation[]
  clinicalNotes  Note[]

  @@index([nutritionistId])
  @@index([status])
  @@map("client_profiles")
}

// ─────────────────────────────────────────
// INVITES & TRIAL
// ─────────────────────────────────────────

model Invite {
  id             String    @id @default(cuid())
  code           String    @unique @default(cuid())
  nutritionistId String
  clientId       String?   @unique
  clientEmail    String?
  status         String    @default("PENDING") // PENDING | ACCEPTED | EXPIRED | REVOKED
  expiresAt      DateTime?
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())

  nutritionist NutritionistProfile @relation(fields: [nutritionistId], references: [id])
  client       ClientProfile?      @relation(fields: [clientId], references: [id])

  @@index([code])
  @@index([nutritionistId])
  @@map("invites")
}

model TrialKey {
  id             String    @id @default(cuid())
  code           String    @unique
  createdById    String    // Admin user id
  nutritionistId String?
  durationDays   Int       @default(30)
  status         String    @default("UNUSED") // UNUSED | ACTIVE | EXPIRED | REVOKED
  activatedAt    DateTime?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())

  subscription Subscription?

  @@index([code])
  @@map("trial_keys")
}

// ─────────────────────────────────────────
// SUBSCRIPTIONS
// ─────────────────────────────────────────

model SubscriptionPlan {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  priceMonthly   Float
  priceYearly    Float?
  maxClients     Int      @default(50)
  maxTeamMembers Int      @default(1)
  maxStorageGb   Int      @default(5)
  features       String   @default("{}") // JSON string
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id                    String    @id @default(cuid())
  nutritionistId        String    @unique
  planId                String
  status                String    @default("TRIAL") // TRIAL | ACTIVE | PAST_DUE | CANCELLED | EXPIRED
  trialKeyId            String?   @unique
  paymentProvider       String?
  paymentSubscriptionId String?
  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime?
  cancelledAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  nutritionist NutritionistProfile @relation(fields: [nutritionistId], references: [id])
  plan         SubscriptionPlan    @relation(fields: [planId], references: [id])
  trialKey     TrialKey?           @relation(fields: [trialKeyId], references: [id])

  @@map("subscriptions")
}

// ─────────────────────────────────────────
// NUTRITION PLANS
// ─────────────────────────────────────────

model NutritionPlan {
  id             String    @id @default(cuid())
  nutritionistId String
  clientId       String
  title          String
  description    String?
  status         String    @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  version        Int       @default(1)
  parentPlanId   String?
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  nutritionist NutritionistProfile @relation(fields: [nutritionistId], references: [id])
  client       ClientProfile       @relation(fields: [clientId], references: [id])
  parentPlan   NutritionPlan?      @relation("PlanVersions", fields: [parentPlanId], references: [id])
  versions     NutritionPlan[]     @relation("PlanVersions")
  days         PlanDay[]

  @@index([clientId])
  @@index([nutritionistId])
  @@index([status])
  @@map("nutrition_plans")
}

model PlanDay {
  id        String  @id @default(cuid())
  planId    String
  dayNumber Int
  label     String?
  notes     String?

  plan  NutritionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  meals Meal[]

  @@index([planId])
  @@map("plan_days")
}

model Meal {
  id            String  @id @default(cuid())
  planDayId     String
  name          String
  scheduledTime String? // e.g. "08:00"
  orderIndex    Int     @default(0)
  notes         String?
  instructions  String?

  planDay  PlanDay    @relation(fields: [planDayId], references: [id], onDelete: Cascade)
  items    MealItem[]
  mealLogs MealLog[]

  @@index([planDayId])
  @@map("meals")
}

model MealItem {
  id         String  @id @default(cuid())
  mealId     String
  foodId     String?
  quantity   Float
  unit       String
  notes      String?
  orderIndex Int     @default(0)

  meal Meal  @relation(fields: [mealId], references: [id], onDelete: Cascade)
  food Food? @relation(fields: [foodId], references: [id])

  @@index([mealId])
  @@map("meal_items")
}

// ─────────────────────────────────────────
// FOODS
// ─────────────────────────────────────────

model Food {
  id              String   @id @default(cuid())
  name            String
  category        String?
  caloriesPer100g Float?
  proteinPer100g  Float?
  carbsPer100g    Float?
  fatPer100g      Float?
  fiberPer100g    Float?
  extraNutrients  String?  // JSON string
  source          String   @default("GLOBAL") // GLOBAL | CUSTOM
  nutritionistId  String?  // null = global food
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  nutritionist NutritionistProfile? @relation("NutritionistFoods", fields: [nutritionistId], references: [id])
  mealItems    MealItem[]

  @@index([name])
  @@index([source])
  @@index([nutritionistId])
  @@map("foods")
}

// ─────────────────────────────────────────
// GOALS
// ─────────────────────────────────────────

model Goal {
  id             String    @id @default(cuid())
  clientId       String
  nutritionistId String
  title          String
  description    String?
  type           String?   // "QUANTITATIVE" | "BEHAVIORAL"
  targetValue    Float?
  unit           String?
  frequency      String?   // "daily", "weekly"
  startDate      DateTime?
  endDate        DateTime?
  status         String    @default("ACTIVE") // ACTIVE | COMPLETED | PAUSED | CANCELLED
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  client       ClientProfile       @relation(fields: [clientId], references: [id])
  nutritionist NutritionistProfile @relation(fields: [nutritionistId], references: [id])
  progress     GoalProgress[]

  @@index([clientId])
  @@map("goals")
}

model GoalProgress {
  id           String   @id @default(cuid())
  goalId       String
  recordedById String
  value        Float?
  note         String?
  recordedAt   DateTime @default(now())

  goal       Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  recordedBy User @relation("GoalProgressRecorder", fields: [recordedById], references: [id])

  @@index([goalId])
  @@map("goal_progress")
}

// ─────────────────────────────────────────
// CONSULTATIONS
// ─────────────────────────────────────────

model Consultation {
  id                 String    @id @default(cuid())
  clientId           String
  nutritionistId     String
  scheduledAt        DateTime
  durationMinutes    Int       @default(60)
  status             String    @default("SCHEDULED") // SCHEDULED | COMPLETED | CANCELLED | NO_SHOW
  notes              String?
  observations       String?
  nextConsultationAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  client       ClientProfile       @relation(fields: [clientId], references: [id])
  nutritionist NutritionistProfile @relation(fields: [nutritionistId], references: [id])
  measurements Measurement[]
  notesRel     Note[]

  @@index([clientId])
  @@index([nutritionistId])
  @@index([scheduledAt])
  @@map("consultations")
}

// ─────────────────────────────────────────
// MEASUREMENTS
// ─────────────────────────────────────────

model MeasurementType {
  id             String   @id @default(cuid())
  name           String
  unit           String
  category       String?
  isGlobal       Boolean  @default(true)
  nutritionistId String?
  displayOrder   Int      @default(0)
  createdAt      DateTime @default(now())

  measurements Measurement[]

  @@map("measurement_types")
}

model Measurement {
  id                String   @id @default(cuid())
  clientId          String
  measurementTypeId String
  value             Float
  unit              String
  measuredAt        DateTime
  recordedById      String
  recordedByRole    String   // NUTRITIONIST | CLIENT
  consultationId    String?
  notes             String?
  createdAt         DateTime @default(now())

  client          ClientProfile   @relation(fields: [clientId], references: [id])
  measurementType MeasurementType @relation(fields: [measurementTypeId], references: [id])
  recordedBy      User            @relation("MeasurementRecorder", fields: [recordedById], references: [id])
  consultation    Consultation?   @relation(fields: [consultationId], references: [id])

  @@index([clientId])
  @@index([measuredAt])
  @@map("measurements")
}

// ─────────────────────────────────────────
// MEAL LOGS (ADHERENCE)
// ─────────────────────────────────────────

model MealLog {
  id          String   @id @default(cuid())
  mealId      String
  clientId    String
  planDayId   String
  logDate     String   // YYYY-MM-DD
  status      String   // COMPLETED | PARTIAL | SKIPPED
  actualItems String?  // JSON string
  note        String?
  photoUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  meal   Meal          @relation(fields: [mealId], references: [id])
  client ClientProfile @relation(fields: [clientId], references: [id])

  @@unique([mealId, clientId, logDate])
  @@index([clientId])
  @@index([logDate])
  @@map("meal_logs")
}

// ─────────────────────────────────────────
// PROGRESS PHOTOS
// ─────────────────────────────────────────

model ProgressPhoto {
  id                String   @id @default(cuid())
  clientId          String
  nutritionistId    String
  fileUrl           String
  fileKey           String   // Storage key
  caption           String?
  category          String?
  takenAt           DateTime
  uploadedByRole    String   // NUTRITIONIST | CLIENT
  isVisibleToClient Boolean  @default(true)
  createdAt         DateTime @default(now())

  client ClientProfile @relation(fields: [clientId], references: [id])

  @@index([clientId])
  @@map("progress_photos")
}

// ─────────────────────────────────────────
// NOTES
// ─────────────────────────────────────────

model Note {
  id             String   @id @default(cuid())
  nutritionistId String
  clientId       String
  title          String?
  content        String
  isPrivate      Boolean  @default(true)
  consultationId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  nutritionist NutritionistProfile @relation(fields: [nutritionistId], references: [id])
  client       ClientProfile       @relation(fields: [clientId], references: [id])
  consultation Consultation?       @relation(fields: [consultationId], references: [id])

  @@index([clientId])
  @@index([nutritionistId])
  @@map("notes")
}

// ─────────────────────────────────────────
// MESSAGING
// ─────────────────────────────────────────

model Conversation {
  id             String   @id @default(cuid())
  nutritionistId String
  clientId       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  nutritionist NutritionistProfile @relation(fields: [nutritionistId], references: [id])
  client       ClientProfile       @relation(fields: [clientId], references: [id])
  messages     Message[]

  @@unique([nutritionistId, clientId])
  @@map("conversations")
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  content        String?
  messageType    String    @default("TEXT") // TEXT | IMAGE | FILE
  attachmentUrl  String?
  attachmentKey  String?
  isRead         Boolean   @default(false)
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id])

  @@index([conversationId])
  @@index([senderId])
  @@map("messages")
}

// ─────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String    // MESSAGE | CONSULTATION | PLAN_UPDATED | GOAL | REMINDER
  title     String
  body      String
  data      String?   // JSON string
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model NotificationPreference {
  id               String  @id @default(cuid())
  userId           String
  notificationType String
  channel          String  // IN_APP | EMAIL
  isEnabled        Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationType, channel])
  @@map("notification_preferences")
}

// ─────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  metadata   String?  // JSON string
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
